# Copy to .env (git-ignored) and set a real value. compose.yaml reads .env automatically.
# SQL Server rejects weak passwords (at least 8 characters, from three of: upper case, lower case, digits, symbols),
# and the container then exits a few seconds after starting.
# Avoid ; and quotes, which would break the connection string. Single quotes keep a $ literal.
# The password is applied only when the volume is first created; after changing it, run: docker compose down -v
MSSQL_SA_PASSWORD=
