#!/bin/sh
# Refuses pushes to main: changes reach main through pull requests, and from Phase 0.2 a push to main deploys.
# GitHub only enforces branch protection on private repos with a paid plan, so this guards against accidents locally.
# Enable once per clone: git config core.hooksPath .githooks
# Bypass deliberately: git push --no-verify

# Git passes one line per ref being pushed: <local ref> <local sha> <remote ref> <remote sha>
while read -r local_ref local_sha remote_ref remote_sha
do
    if [ "$remote_ref" = "refs/heads/main" ]; then
        echo "pre-push: refusing to push to main. Push a branch and open a pull request instead." >&2
        exit 1
    fi
done

exit 0
