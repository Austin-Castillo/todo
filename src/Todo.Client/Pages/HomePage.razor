@page "/"
@inject ITodoService Todos
@inject NavigationManager Navigation

<PageTitle>Todo</PageTitle>

<h1>Todo lists</h1>

@* Prerendered HTML is visible before the browser app has started; until then clicks and typing would be lost. *@
<fieldset disabled="@(!RendererInfo.IsInteractive)">
    <form @onsubmit="CreateList">
        <input @bind="newListName" @bind:event="oninput" maxlength="@TodoLimits.ListNameMaxLength"
               placeholder="New list" aria-label="New list name" />
        <button type="submit" disabled="@(string.IsNullOrWhiteSpace(newListName) || saving)">Add</button>
    </form>
</fieldset>

@if (error is not null)
{
    <p class="error">@error</p>
}

@if (Lists is null)
{
    <p>Loading...</p>
}
else if (Lists.Count == 0)
{
    <p>No lists yet.</p>
}
else
{
    <ul class="rows">
        @foreach (var list in Lists)
        {
            <li>
                <a href="lists/@list.Id">@list.Name</a>
                <span class="muted">@list.CompletedCount of @list.ItemCount done</span>
            </li>
        }
    </ul>
}

@code {
    // Loaded on the server while prerendering, then written into the page, so the browser app starts with it
    // instead of loading it again. Must be a public property.
    [PersistentState]
    public List<TodoListSummary>? Lists { get; set; }

    private string newListName = "";
    private bool saving;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        Lists ??= await Todos.GetListsAsync();
    }

    private async Task CreateList()
    {
        // Disables the button from the first await until the response arrives, so a double click can't create two lists.
        saving = true;
        error = null;

        var created = await Todos.CreateListAsync(new CreateTodoListRequest(newListName.Trim()));
        if (created is null)
        {
            error = "Couldn't save the list.";
            saving = false;
            return;
        }

        // A new list has no items yet, so go straight to it to add some.
        Navigation.NavigateTo($"lists/{created.Id}");
    }
}
