@page "/lists/{Id:int}"
@inject ITodoService Todos
@inject NavigationManager Navigation

<PageTitle>@(CurrentList?.Name ?? "Todo")</PageTitle>

<p><a href="">&larr; All lists</a></p>

@if (CurrentList is null)
{
    <p>Loading...</p>
}
else
{
    @* Prerendered HTML is visible before the browser app has started; until then clicks and typing would be lost. *@
    <fieldset disabled="@(!RendererInfo.IsInteractive)">
        @if (renaming)
        {
            <form @onsubmit="SaveName">
                <input @bind="nameDraft" @bind:event="oninput" maxlength="@TodoLimits.ListNameMaxLength" aria-label="List name" />
                <button type="submit" disabled="@(string.IsNullOrWhiteSpace(nameDraft) || saving)">Save</button>
                <button type="button" @onclick="() => renaming = false">Cancel</button>
            </form>
        }
        else
        {
            <div class="heading">
                <h1>@CurrentList.Name</h1>
                <button @onclick="StartRename">Rename</button>
                <button @onclick="() => confirmingDelete = true">Delete list</button>
            </div>
        }

        @if (confirmingDelete)
        {
            <p>
                Delete "@CurrentList.Name" and its @CurrentList.Items.Count items?
                <button @onclick="DeleteList" disabled="@saving">Delete</button>
                <button @onclick="() => confirmingDelete = false">Cancel</button>
            </p>
        }

        <form @onsubmit="AddItem">
            <input @bind="newItemContent" @bind:event="oninput" maxlength="@TodoLimits.ItemContentMaxLength"
                   placeholder="New item" aria-label="New item" />
            <button type="submit" disabled="@(string.IsNullOrWhiteSpace(newItemContent) || saving)">Add</button>
        </form>

        @if (error is not null)
        {
            <p class="error">@error</p>
        }

        @if (CurrentList.Items.Count == 0)
        {
            <p>No items yet.</p>
        }
        else
        {
            <ul class="rows">
                @foreach (var item in CurrentList.Items)
                {
                    <li>
                        @if (editingId == item.Id)
                        {
                            <form @onsubmit="() => SaveContent(item)">
                                <input @bind="contentDraft" @bind:event="oninput" maxlength="@TodoLimits.ItemContentMaxLength"
                                       aria-label="Item text" />
                                <button type="submit" disabled="@(string.IsNullOrWhiteSpace(contentDraft) || saving)">Save</button>
                                <button type="button" @onclick="() => editingId = null">Cancel</button>
                            </form>
                        }
                        else
                        {
                            <label class="@(item.IsComplete ? "done" : null)">
                                <input type="checkbox" checked="@item.IsComplete" @onchange="() => Toggle(item)" disabled="@saving" />
                                @item.Content
                            </label>
                            <span>
                                <button @onclick="() => StartEdit(item)">Edit</button>
                                <button @onclick="() => DeleteItem(item)" disabled="@saving">Delete</button>
                            </span>
                        }
                    </li>
                }
            </ul>
        }
    </fieldset>
}

@code {
    [Parameter] public int Id { get; set; }

    // Loaded on the server while prerendering, then written into the page, so the browser app starts with it
    // instead of loading it again. Must be a public property.
    [PersistentState]
    public TodoListDetails? CurrentList { get; set; }

    private bool saving;
    private string? error;

    private string newItemContent = "";
    private bool renaming;
    private string nameDraft = "";
    private bool confirmingDelete;
    private int? editingId;
    private string contentDraft = "";

    // Not OnInitializedAsync: going from one list to another reuses this component instance with a new Id.
    protected override async Task OnParametersSetAsync()
    {
        // Already showing this list: restored from prerendering, or the same list rendering again.
        if (CurrentList?.Id == Id)
        {
            return;
        }

        CurrentList = null;
        error = null;
        renaming = false;
        confirmingDelete = false;
        editingId = null;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        CurrentList = await Todos.GetListAsync(Id);
        if (CurrentList is null)
        {
            // Shows the router's NotFoundPage instead: a real 404 response when the server renders it.
            Navigation.NotFound();
        }
    }

    // Every write: disable the buttons, send, then reload so the page shows what the server actually stored,
    // even when the write failed (for example, an item someone else already deleted).
    private async Task<bool> SaveAsync(Func<Task<bool>> save)
    {
        saving = true;
        error = null;

        var succeeded = await save();
        if (!succeeded)
        {
            error = "Couldn't save the change.";
        }

        await LoadAsync();
        saving = false;
        return succeeded;
    }

    private async Task AddItem()
    {
        if (await SaveAsync(async () => await Todos.CreateItemAsync(Id, new CreateTodoItemRequest(newItemContent.Trim())) is not null))
        {
            newItemContent = "";
        }
    }

    // An update replaces the whole item, so toggling sends the content from the last load too. If it changed elsewhere
    // since, this overwrites it: the lost update that the Stage 1.1 concurrency token fixes.
    private Task Toggle(TodoItemDto item) =>
        SaveAsync(() => Todos.UpdateItemAsync(item.Id, new UpdateTodoItemRequest(item.Content, !item.IsComplete)));

    private void StartEdit(TodoItemDto item)
    {
        editingId = item.Id;
        contentDraft = item.Content;
    }

    private async Task SaveContent(TodoItemDto item)
    {
        if (await SaveAsync(() => Todos.UpdateItemAsync(item.Id, new UpdateTodoItemRequest(contentDraft.Trim(), item.IsComplete))))
        {
            editingId = null;
        }
    }

    private Task DeleteItem(TodoItemDto item) =>
        SaveAsync(() => Todos.DeleteItemAsync(item.Id));

    private void StartRename()
    {
        nameDraft = CurrentList!.Name;
        renaming = true;
    }

    private async Task SaveName()
    {
        if (await SaveAsync(() => Todos.UpdateListAsync(Id, new UpdateTodoListRequest(nameDraft.Trim()))))
        {
            renaming = false;
        }
    }

    private async Task DeleteList()
    {
        saving = true;

        // If the delete didn't succeed, check whether the list is gone anyway (deleted elsewhere):
        // either way there's no list left to show.
        if (await Todos.DeleteListAsync(Id) || await Todos.GetListAsync(Id) is null)
        {
            Navigation.NavigateTo("");
            return;
        }

        error = "Couldn't delete the list.";
        saving = false;
    }
}
