<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* Rendered by the server on each full page load, so @Assets, ResourcePreloader and ImportMap write the current
       fingerprinted file names straight from the static assets manifest. *@
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveWebAssembly" />
</head>

<body>
    @* The whole app runs in the browser as WebAssembly. Each full page load is prerendered here first (the default),
       so the page arrives with its data and the browser app takes over once it has started. *@
    <Routes @rendermode="InteractiveWebAssembly" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
